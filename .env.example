# Личный Freemium GigaChat. Authorization key из Studio, без Basic.
# Ключ вписывайте только в .env. Не публикуйте и не присылайте его в чат.
LLM_PROVIDER=gigachat
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2-Pro
# Путь к PEM-сертификату НУЦ. Относительный путь считается от папки .env.
GIGACHAT_CA_BUNDLE_FILE=.certs/russian_trusted_root_ca_pem.crt
GIGACHAT_TIMEOUT=30
GIGACHAT_MAX_TOKENS=1024
GIGACHAT_TEMPERATURE=0.2
